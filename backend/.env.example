# Examples only. Spring does not automatically read this file; export variables.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
BUBBLE_MAX_REQUEST_BYTES=1048576
DB_URL=jdbc:postgresql://localhost:5432/bubble
DB_USERNAME=choose_a_local_role
# Set DB_PASSWORD outside this committed file. No credentials are supplied here.
# DB_PASSWORD=
# Future secrets belong in environment variables, never in committed files.

# Single-process authentication attempt budgets; fixed 60-second windows.
BUBBLE_AUTH_PER_ADDRESS_PER_MINUTE=60
BUBBLE_AUTH_TOTAL_PER_MINUTE=300
