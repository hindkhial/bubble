# Public backend origin or proxy base; do not append /api/v1. Never put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional private staging build UI; contains no credentials and does not bypass the tester gate.
# EXPO_PUBLIC_PRIVATE_BETA_ACCESS=1

# Required before native generation: use only the owner-approved identifier.
# BUBBLE_IOS_BUNDLE_IDENTIFIER=
# Physical iPhone: EXPO_PUBLIC_API_URL must use a reachable trusted HTTPS origin.
# Never embed credentials or the private staging gate password in the app.
