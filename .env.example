# Public backend origin or proxy base; do not append /api/v1. Never put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Required before native generation: use only the owner-approved identifier.
# BUBBLE_IOS_BUNDLE_IDENTIFIER=
