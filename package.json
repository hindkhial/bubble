{
  "name": "bubble-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:mobile": "expo export --platform ios && expo export --platform android",
    "test:account-live": "node --experimental-strip-types scripts/account-smoke.mjs",
    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "benchmark:local": "node --experimental-strip-types scripts/benchmark.mjs",
    "benchmark:account": "node --experimental-strip-types scripts/benchmark-account.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.24",
    "expo-image-picker": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2"
    }
  }
}
